# MongoDB connection string (Atlas or local)
# Replace <username>, <password>, <cluster> with your credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT secrets (generate random 256-bit hex keys):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-random-64-char-hex-secret-here
JWT_REFRESH_SECRET=your-random-64-char-hex-secret-here

# Access/refresh token lifetimes
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Application port. Local dev uses 3001 (the frontend's default API target).
# On Render/Fly the platform injects PORT automatically.
PORT=3001

# Comma-separated list of origins allowed to call the API with credentials.
# Local dev defaults to http://localhost:3000 when unset.
# Production example: https://taskflow.vercel.app
CORS_ORIGIN=http://localhost:3000
