
# Cookie SameSite policy.
#   lax  - frontend and API share a site (local dev, Cloudflare tunnel demo)
#   none - cross-site deploy (Vercel frontend + Render API); requires HTTPS
#
# When none, cookies are automatically marked Secure (the browser rejects
# SameSite=None cookies without it), regardless of NODE_ENV.
COOKIE_SAME_SITE=lax
