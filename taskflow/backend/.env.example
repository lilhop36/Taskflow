# MongoDB connection string (Atlas or local)
# Replace <username>, <password>, <cluster> with your credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT secret key (generate a random 256-bit key)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-64-char-hex-secret-here

# JWT expiration durations
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d

# Application port
PORT=3000
